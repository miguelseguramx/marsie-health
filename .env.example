# Postgres (consumed by the `db` service in compose.yaml)
POSTGRES_DB=marsie_health
POSTGRES_USER=marsie
POSTGRES_PASSWORD=changeme

# Django
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database URL (consumed by Django via django-environ)
DATABASE_URL=postgres://marsie:changeme@db:5432/marsie_health

# Email & links (console backend in dev prints messages to stdout)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@marsie.local
FRONTEND_URL=http://localhost:5173

# AWS S3 (raw report PDFs) — populate from `terraform output` in infra/terraform
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
